# =============================================================================
# medicine-alerts/backend — local dev & Vercel env template
# =============================================================================
# Copy to .env and fill in real values (never commit .env):
#   copy .env.example .env
#
# Local run:  python api_server.py   (loads this file via python-dotenv)
# Vercel:     set the same keys in Project → Settings → Environment Variables
# =============================================================================

# --- Required: PostgreSQL (Neon, local Postgres, etc.) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special chars in password (@ → %40, # → %23, etc.)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/curax_central

# Alternative name (same DB); DATABASE_URL takes precedence when both set
# CENTRAL_DB_URL=

# --- Data bus (Ably fan-out on Vercel) ---
DATA_BUS_URL=https://databus.vercel.app

# --- Signup / OTP / password-reset email (Gmail app password recommended) ---
SIGNUP_SMTP_USER=your-email@gmail.com
SIGNUP_SMTP_PASSWORD=
# SIGNUP_SMTP_HOST=smtp.gmail.com
# SIGNUP_SMTP_PORT=465
# SIGNUP_EMAIL_FROM=
# SIGNUP_EMAIL_FROM_NAME=Curax system
# SIGNUP_EMAIL_REPLY_TO=

# --- Security (change defaults before production) ---
# SIGNUP_OTP_PEPPER=change-me-to-a-long-random-string
# MAINTENANCE_API_KEY=
# CRON_SECRET=

# --- Social sign-in (optional) ---
# GOOGLE_SIGNIN_WEB_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Alert relay WebSocket (default shown if unset) ---
# RELAY_URL=wss://curax-relay.onrender.com

# --- Local API port (default 5050) ---
# PORT=5050

# --- Dev only: return OTP in API response (never enable in production) ---
# SIGNUP_DEV_RETURN_OTP=0
