<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.facebook.katana" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Built-in tone catalog (MediaStore ringtone/alarm rows); runtime prompt can be added later -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:name=".CuraxApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_inset"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_inset"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curax"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <activity
            android:name=".AlertDetailActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Curax">
            <intent-filter>
                <action android:name="CURAX_ALERT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".SetPinActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".ReliabilityCautionsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.Curax.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".SignUpRegistrationActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".SignUpLinkAdminActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".JoinInviteActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Curax">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="join"
                    android:scheme="curax" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="curax.app"
                    android:pathPrefix="/join"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdminRegistrationActivity"
            android:exported="false"
            android:parentActivityName=".LaunchActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdminMobileVerifyActivity"
            android:exported="false"
            android:parentActivityName=".AdminRegistrationActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdminSignUpActivity"
            android:exported="false"
            android:parentActivityName=".AdminRegistrationActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdminEmailSignupVerifyActivity"
            android:exported="false"
            android:parentActivityName=".AdminSignUpActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PinSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".PinEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".UserStandaloneActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax.UserToolbar" />

        <activity
            android:name=".UserAmbientMonitorActivity"
            android:exported="false"
            android:parentActivityName=".UserStandaloneActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".Esp32BlePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".CreateHealthHubPlanActivity"
            android:exported="false"
            android:parentActivityName=".UserStandaloneActivity"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StandaloneLocalAlertSettingsActivity"
            android:exported="false"
            android:parentActivityName=".UserStandaloneActivity"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StandaloneAlertSoundPickerActivity"
            android:exported="false"
            android:parentActivityName=".StandaloneLocalAlertSettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".AdminUserChatActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".AdminCareSettingsActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity"
            android:theme="@style/Theme.Curax" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".AlertConnectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".LocalAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.curax.app.action.LOCAL_STANDALONE_ALERT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LocalAlertsBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".CuraxNextDoseWidgetProvider"
            android:exported="false"
            android:label="@string/widget_next_dose_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.curax.app.action.WIDGET_NEXT_DOSE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/curax_next_dose_widget_info" />
        </receiver>
    </application>
</manifest>
