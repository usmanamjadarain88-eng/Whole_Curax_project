<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.facebook.katana" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Built-in tone catalog (MediaStore ringtone/alarm rows); runtime prompt can be added later -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:name=".CuraxApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_inset"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_inset"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curax"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <activity
            android:name=".AlertDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Curax">
            <intent-filter>
                <action android:name="CURAX_ALERT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".SetPinActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.Curax.AuthOnboarding">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".SignUpRegistrationActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".SignUpLinkAdminActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".AdminRegistrationActivity"
            android:exported="false"
            android:parentActivityName=".SignInActivity"
            android:theme="@style/Theme.Curax.AuthOnboarding" />

        <activity
            android:name=".PinSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".PinEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".UserDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".UserStandaloneActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax.UserToolbar" />

        <activity
            android:name=".UserAmbientMonitorActivity"
            android:exported="false"
            android:parentActivityName=".UserStandaloneActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".Esp32BlePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".CreateHealthHubPlanActivity"
            android:exported="false"
            android:parentActivityName=".UserStandaloneActivity"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StandaloneLocalAlertSettingsActivity"
            android:exported="false"
            android:parentActivityName=".UserStandaloneActivity"
            android:theme="@style/Theme.Curax"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StandaloneAlertSoundPickerActivity"
            android:exported="false"
            android:parentActivityName=".StandaloneLocalAlertSettingsActivity"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Curax" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Curax" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".AlertConnectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".CuraxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="curax_alert_channel" />

        <receiver
            android:name=".LocalAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.curax.app.action.LOCAL_STANDALONE_ALERT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LocalAlertsBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
