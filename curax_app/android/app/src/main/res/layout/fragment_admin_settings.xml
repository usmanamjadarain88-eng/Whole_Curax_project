<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Same structure as desktop. Edit below and tap Save when ready."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Alert settings section: mild boundary around all alert blocks + Save Alert Settings inside -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

        <!-- Medicine Time Alerts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medicine Time Alerts"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_medicine_30_before" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="30 min before" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_medicine_15_before" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15 min before" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_medicine_exact" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exact time" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Snooze duration (minutes)" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/et_medicine_snooze" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:hint="5" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Missed Dose Escalation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Missed Dose Escalation"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_missed_5_min" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="After 5 min: reminder" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_missed_15_urgent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="After 15 min: urgent alert" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_missed_30_family" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="After 30 min: notify family" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_missed_1hr_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="After 1 hour: log as missed" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/admin_family_alert_email_label" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/et_missed_family_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:hint="@string/admin_family_alert_email_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stock Alerts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Alerts"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_stock_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Enable stock alerts" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Low stock threshold" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/et_stock_threshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:hint="5" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_stock_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alert when empty" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_stock_critical" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Critical alert when low" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Expiry Alerts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry Alerts"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_expiry_30" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="30 days before" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_expiry_15" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15 days before" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_expiry_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="7 days before" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb_expiry_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 day before" android:textColor="@color/text_primary" android:buttonTint="@color/checkbox_tint" android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_alert_settings"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Save Alert Settings"
                    app:backgroundTint="@color/button_primary_bg"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Email alerts: recipient + toggle; SMTP sender stays on CuraX server / desktop -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gmail_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/system_gmail_section_title"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/system_gmail_curax_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/group_gmail_admin_readonly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_care_gmail_status_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_gmail_user_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/admin_care_gmail_email_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_gmail_user_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_gmail_user_editable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_gmail_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/system_gmail_alerts_switch"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:thumbTint="@color/checkbox_tint"
                    app:trackTint="@color/summary_stroke" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:hintEnabled="true"
                    android:hint="@string/system_gmail_recipient_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_gmail_recipients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_gmail"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/system_gmail_save"
                    app:backgroundTint="@color/button_primary_bg"
                    app:cornerRadius="12dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Care mode (default linked user): medicine box device PIN — read-only -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_care_device_pin_readonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/care_device_pin_section_title"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/care_device_pin_admin_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_care_device_pin_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textIsSelectable="true"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Care mode only (visibility from code): user's app unlock PIN synced from their device -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_care_app_unlock_pin_readonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_care_unlock_pin_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/care_unlock_pin_section_title"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_care_unlock_pin_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/care_unlock_pin_admin_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_care_unlock_pin_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textIsSelectable="true"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Device PIN over BLE — same protocol as desktop USB (SET_PASSWORD) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEsp32DevicePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device PIN (ESP32)"
                    android:textColor="@color/connection_panel_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEsp32BleHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="Connect to your device from Dose tracking (BLE) first."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Current PIN"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/etEsp32PwdCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Current 4+ digit PIN"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="New PIN"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/etEsp32PwdNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="New PIN (4+ digits)"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Confirm new PIN"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/etEsp32PwdConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Repeat new PIN"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEsp32ApplyPassword"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Update device PIN"
                    app:backgroundTint="@color/button_primary_bg"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>

