<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_surface_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSetPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:minHeight="?attr/actionBarSize"
        android:paddingStart="2dp"
        android:paddingEnd="8dp"
        app:navigationContentDescription="@string/pin_setup_back_content_description"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:letterSpacing="-0.031"
                android:text="@string/pin_toolbar_title"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.12"
                android:text="@string/set_pin_screen_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                android:minHeight="@dimen/auth_outlined_edit_min_height"
                app:boxBackgroundColor="@color/key_value_bg"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/summary_stroke"
                app:boxCollapsedPaddingTop="0dp"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_secondary"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:hint="@string/pin_hint_4_digit"
                    android:includeFontPadding="true"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    android:paddingStart="12dp"
                    android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                    android:paddingEnd="12dp"
                    android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                android:minHeight="@dimen/auth_outlined_edit_min_height"
                app:boxBackgroundColor="@color/key_value_bg"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/summary_stroke"
                app:boxCollapsedPaddingTop="0dp"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_secondary"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPinConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:hint="@string/pin_confirm_hint"
                    android:includeFontPadding="true"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    android:paddingStart="12dp"
                    android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                    android:paddingEnd="12dp"
                    android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavePin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_auth_login_cta"
                android:letterSpacing="0"
                android:stateListAnimator="@null"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/auth_login_label"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemovePin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/remove_pin"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="10dp"
                app:strokeColor="@color/auth_field_border"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
