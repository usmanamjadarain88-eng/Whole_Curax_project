<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_onboarding_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="0dp"
        android:paddingBottom="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvLinkAdminTitleLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="102dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.031"
                    android:text="@string/link_admin_heading_line1"
                    android:textColor="@color/auth_heading"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Connect to" />

                <TextView
                    android:id="@+id/tvLinkAdminTitleLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.031"
                    android:text="@string/link_admin_heading_line2"
                    android:textColor="@color/auth_heading"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="admin" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <TextView
                        android:id="@+id/tvLinkIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/signup_admin_step_subtitle"
                        android:textColor="@color/auth_subtitle"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLinkSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="start"
                        android:textColor="@color/auth_subtitle"
                        android:textSize="14sp"
                        tools:text="Using account: you@example.com" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="343dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:minHeight="42dp"
                        app:boxBackgroundColor="@android:color/white"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/auth_outline_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintAnimationEnabled="false"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminConnectionCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:hint="@string/connection_code_hint"
                            android:inputType="textVisiblePassword"
                            android:minHeight="42dp"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:textColor="@color/auth_field_text"
                            android:textColorHint="@color/auth_subtitle"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Same vertical gap as tvResendCountdown marginTop on verify -->
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <!-- Decorative row (not an action label) -->
                    <TextView
                        android:id="@+id/tvLinkToAdminMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:alpha="0.55"
                        android:clickable="false"
                        android:enabled="false"
                        android:focusable="false"
                        android:fontFamily="@font/inter"
                        android:paddingVertical="8dp"
                        android:text="@string/signup_link_admin_decor"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLinkAdmin"
                        android:layout_width="343dp"
                        android:layout_height="47dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="22dp"
                        android:alpha="0.45"
                        android:background="@drawable/bg_auth_login_cta"
                        android:enabled="false"
                        android:letterSpacing="0"
                        android:paddingStart="10dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="14dp"
                        android:stateListAnimator="@null"
                        android:text="@string/connect"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_login_label"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
