<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Same typography as SignUpActivity tvScreenTitle (Verify PIN) -->
        <TextView
            android:id="@+id/tvLinkAdminTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:text="@string/connect_to_admin"
            android:textColor="@color/connection_panel_title"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Connect to admin" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_auth_panel_flat"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Match verify step: intro (13sp start) + subtitle (13sp, 8dp top) -->
                    <TextView
                        android:id="@+id/tvLinkIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:gravity="start"
                        android:text="@string/signup_admin_step_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLinkSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:gravity="start"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Using account: you@example.com" />

                    <!-- Same top spacing as OTP block on verify (14dp) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="@color/key_value_bg"
                        app:boxCornerRadiusBottomEnd="0dp"
                        app:boxCornerRadiusBottomStart="0dp"
                        app:boxCornerRadiusTopEnd="0dp"
                        app:boxCornerRadiusTopStart="0dp"
                        app:boxStrokeColor="@android:color/transparent"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminConnectionCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:hint="@string/connection_code_hint"
                            android:inputType="textVisiblePassword"
                            android:minHeight="56dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Same vertical gap as tvResendCountdown marginTop on verify -->
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <!-- Same disabled look as verify Resend row (tvResend) -->
                    <TextView
                        android:id="@+id/tvLinkToAdminMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:alpha="0.45"
                        android:clickable="false"
                        android:enabled="false"
                        android:focusable="false"
                        android:fontFamily="@font/inter"
                        android:paddingVertical="8dp"
                        android:text="@string/link_to_admin"
                        android:textColor="@color/connection_panel_title"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLinkAdmin"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp"
                        android:alpha="0.45"
                        android:enabled="false"
                        android:text="@string/connect"
                        android:textColor="@color/sign_up_button_text"
                        android:textSize="15sp"
                        app:backgroundTint="@color/sign_up_button_background"
                        app:cornerRadius="0dp"
                        app:elevation="0dp"
                        app:rippleColor="@color/sign_up_button_ripple" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
