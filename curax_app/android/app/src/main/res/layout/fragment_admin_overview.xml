<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeAdminOverview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:id="@+id/scrollAdminOverviewContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="@dimen/panel_stroke_width">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main Dashboard"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap any box to view medicine details"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardB1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/med_box_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/med_box_stroke"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B1" android:textColor="@color/med_box_label" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/med_box_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB1Qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/med_box_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardB2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/med_box_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/med_box_stroke"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B2" android:textColor="@color/med_box_label" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/med_box_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB2Qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/med_box_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardB3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/med_box_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/med_box_stroke"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B3" android:textColor="@color/med_box_label" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB3Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/med_box_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB3Qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/med_box_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardB4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/med_box_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/med_box_stroke"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B4" android:textColor="@color/med_box_label" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB4Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/med_box_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB4Qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/med_box_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardB5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/med_box_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/med_box_stroke"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B5" android:textColor="@color/med_box_label" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB5Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/med_box_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB5Qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/med_box_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardB6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/med_box_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/med_box_stroke"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B6" android:textColor="@color/med_box_label" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB6Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/med_box_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBoxB6Qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/med_box_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="@dimen/panel_stroke_width">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Distribution"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="148dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/frameDonut"
                        android:layout_width="136dp"
                        android:layout_height="136dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:elevation="8dp">
                        <View
                            android:id="@+id/viewDonutCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_admin_donut"
                            android:elevation="10dp" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:elevation="40dp">
                            <TextView
                                android:id="@+id/tvDonutTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:elevation="50dp"
                                android:background="@android:color/transparent"
                                android:gravity="center" />
                        </LinearLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvDistNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal: 0" android:textColor="#0E7A57" />
                        <TextView android:id="@+id/tvDistLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Low: 0" android:textColor="#D97706" />
                        <TextView android:id="@+id/tvDistExpiring" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Expiring: 0" android:textColor="#DC2626" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="@dimen/panel_stroke_width">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medication Adherence Trend (Last 7 Days)"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <com.curax.app.AdherenceLineChartView
                    android:id="@+id/adherenceChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChartPrev"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Previous"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvChartPageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="12 Feb - 18 Feb"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChartNext"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="4">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKpiTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="@color/summary_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/summary_stroke"
                app:strokeWidth="@dimen/panel_stroke_width">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/tvKpiTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKpiLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="@color/summary_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/summary_stroke"
                app:strokeWidth="@dimen/panel_stroke_width">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Low" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/tvKpiLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#D97706" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKpiExpiring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="@color/summary_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/summary_stroke"
                app:strokeWidth="@dimen/panel_stroke_width">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expiring" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/tvKpiExpiring" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#DC2626" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKpiRefill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardBackgroundColor="@color/summary_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/summary_stroke"
                app:strokeWidth="@dimen/panel_stroke_width">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refill" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/tvKpiRefill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#D97706" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="@dimen/panel_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medicine Inventory"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInventoryHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="6/6 boxes"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:id="@+id/hsvAdminInventoryTable"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp">

                            <TextView
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Name"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:gravity="center"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Box"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1" />
                            <TextView
                                android:layout_width="52dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:gravity="center"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Stock"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1" />
                            <TextView
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:gravity="center"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Dose"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1" />
                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:gravity="center"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Time"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1" />
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:gravity="center"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Expiry"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1" />
                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:gravity="center"
                                android:background="@drawable/bg_inventory_header_cell"
                                android:text="Status"
                                android:textColor="@color/connection_panel_title"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvInventory"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginTop="6dp"
                            android:clipToPadding="false"
                            android:paddingBottom="4dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddMedicine"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Add"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/key_value_stroke"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditMedicine"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:text="Edit"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/key_value_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveMedicine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Clear Box"
                        android:textColor="@color/button_primary_text"
                        app:backgroundTint="@color/button_primary_bg" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
