<?xml version="1.0" encoding="utf-8"?>
<!-- Form scrolls; footer pinned like sign-in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_onboarding_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSignUpRegister"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        android:scrollbars="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/signUpContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="36dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glNames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_names" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_email" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_password" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_confirm" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glOrSocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_or_social" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glSocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_social" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glMarketing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_marketing" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_terms" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="@dimen/signup_guide_button" />

            <TextView
                android:id="@+id/tvSignUpTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="@dimen/auth_screen_title_margin_top"
                android:layout_marginEnd="16dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/sign_up_screen_title"
                android:textColor="@color/auth_heading"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Sign up" />

            <TextView
                android:id="@+id/tvSignUpSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:lineSpacingMultiplier="1.12"
                android:text="@string/sign_up_subtitle_long"
                android:textColor="@color/auth_subtitle"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSignUpTitle"
                tools:text="Sign up to get started…" />

            <LinearLayout
                android:id="@+id/rowSignupNames"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glNames">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    app:boxBackgroundColor="@android:color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="@dimen/signup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/signup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/signup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/signup_field_corner"
                    app:boxStrokeColor="@color/signup_til_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:cursorColor="@color/auth_field_text"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="personGivenName"
                        android:gravity="center_vertical"
                        android:hint="@string/hint_first_name"
                        android:importantForAutofill="yes"
                        android:includeFontPadding="true"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="@dimen/signup_field_height"
                        android:paddingStart="12dp"
                        android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                        android:paddingEnd="12dp"
                        android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                        android:textColor="@color/auth_field_text"
                        android:textColorHint="@color/auth_password_hint"
                        android:textCursorDrawable="@drawable/auth_text_cursor"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    app:boxBackgroundColor="@android:color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="@dimen/signup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/signup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/signup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/signup_field_corner"
                    app:boxStrokeColor="@color/signup_til_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:cursorColor="@color/auth_field_text"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="personFamilyName"
                        android:gravity="center_vertical"
                        android:hint="@string/hint_last_name"
                        android:importantForAutofill="yes"
                        android:includeFontPadding="true"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="@dimen/signup_field_height"
                        android:paddingStart="12dp"
                        android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                        android:paddingEnd="12dp"
                        android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                        android:textColor="@color/auth_field_text"
                        android:textColorHint="@color/auth_password_hint"
                        android:textCursorDrawable="@drawable/auth_text_cursor"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmailSignup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                app:boxBackgroundColor="@android:color/white"
                app:boxBackgroundMode="outline"
                app:boxCollapsedPaddingTop="0dp"
                app:boxCornerRadiusBottomEnd="@dimen/signup_field_corner"
                app:boxCornerRadiusBottomStart="@dimen/signup_field_corner"
                app:boxCornerRadiusTopEnd="@dimen/signup_field_corner"
                app:boxCornerRadiusTopStart="@dimen/signup_field_corner"
                app:boxStrokeColor="@color/signup_til_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:cursorColor="@color/auth_field_text"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glEmail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:gravity="center_vertical"
                    android:hint="@string/signup_placeholder_email"
                    android:importantForAutofill="yes"
                    android:includeFontPadding="true"
                    android:inputType="textEmailAddress"
                    android:minHeight="@dimen/signup_field_height"
                    android:paddingStart="12dp"
                    android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                    android:paddingEnd="12dp"
                    android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                    android:textColor="@color/auth_field_text"
                    android:textColorHint="@color/auth_password_hint"
                    android:textCursorDrawable="@drawable/auth_text_cursor"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPasswordSignup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                app:boxBackgroundColor="@android:color/white"
                app:boxBackgroundMode="outline"
                app:boxCollapsedPaddingTop="0dp"
                app:boxCornerRadiusBottomEnd="@dimen/signup_field_corner"
                app:boxCornerRadiusBottomStart="@dimen/signup_field_corner"
                app:boxCornerRadiusTopEnd="@dimen/signup_field_corner"
                app:boxCornerRadiusTopStart="@dimen/signup_field_corner"
                app:boxStrokeColor="@color/signup_til_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:cursorColor="@color/auth_field_text"
                app:endIconContentDescription="@string/cd_show_password"
                app:endIconDrawable="@drawable/ic_auth_password_hidden"
                app:endIconMode="custom"
                app:endIconTint="@color/auth_password_toggle_tint"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glPassword">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:gravity="center_vertical"
                    android:hint="@string/sign_in_password_hint_dots"
                    android:importantForAutofill="yes"
                    android:includeFontPadding="true"
                    android:inputType="textPassword"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="1"
                    android:minHeight="@dimen/signup_field_height"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                    android:paddingEnd="44dp"
                    android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                    android:scrollbars="none"
                    android:textColor="@color/auth_field_text"
                    android:textColorHint="@color/auth_password_hint"
                    android:textCursorDrawable="@drawable/auth_text_cursor"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmSignup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                app:boxBackgroundColor="@android:color/white"
                app:boxBackgroundMode="outline"
                app:boxCollapsedPaddingTop="0dp"
                app:boxCornerRadiusBottomEnd="@dimen/signup_field_corner"
                app:boxCornerRadiusBottomStart="@dimen/signup_field_corner"
                app:boxCornerRadiusTopEnd="@dimen/signup_field_corner"
                app:boxCornerRadiusTopStart="@dimen/signup_field_corner"
                app:boxStrokeColor="@color/signup_til_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:cursorColor="@color/auth_field_text"
                app:endIconContentDescription="@string/cd_show_password"
                app:endIconDrawable="@drawable/ic_auth_password_hidden"
                app:endIconMode="custom"
                app:endIconTint="@color/auth_password_toggle_tint"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glConfirm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:gravity="center_vertical"
                    android:hint="@string/sign_in_password_hint_dots"
                    android:importantForAutofill="yes"
                    android:includeFontPadding="true"
                    android:inputType="textPassword"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="1"
                    android:minHeight="@dimen/signup_field_height"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                    android:paddingEnd="44dp"
                    android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                    android:scrollbars="none"
                    android:textColor="@color/auth_field_text"
                    android:textColorHint="@color/auth_password_hint"
                    android:textCursorDrawable="@drawable/auth_text_cursor"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/rowOrSocial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glOrSocial">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="#D9D9D9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/sign_up_or_social"
                    android:textColor="@color/auth_subtitle"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:background="#D9D9D9" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSocialButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glSocial">

                <ImageButton
                    android:id="@+id/btnGoogleSignup"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/signup_social_button_height"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_signup_social_button"
                    android:contentDescription="@string/sign_up_google"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_social_google" />

                <ImageButton
                    android:id="@+id/btnFacebookSignup"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/signup_social_button_height"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_signup_social_button"
                    android:contentDescription="@string/sign_up_facebook"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_social_facebook" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMarketing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glMarketing">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbMarketingEmails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:labelFor="@id/cbMarketingEmails"
                    android:maxLines="1"
                    android:text="@string/sign_up_marketing_opt_in"
                    android:textColor="@color/auth_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTermsSignUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glTerms">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbTermsAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/tvTermsDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:labelFor="@id/cbTermsAgree"
                    android:maxLines="2"
                    android:textColor="@color/auth_subtitle"
                    android:textSize="11sp"
                    tools:text="Yes, I understand…" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreateAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_auth_login_cta"
                android:enabled="false"
                android:letterSpacing="0"
                android:minHeight="50dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:text="@string/sign_up_button"
                android:textAllCaps="false"
                android:textColor="@color/auth_login_label"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/blockFooterSignUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/already_have_account_question"
            android:textColor="@color/auth_promo_muted"
            android:textSize="14sp"
            android:textStyle="normal"
            tools:text="Already have an account?" />

        <TextView
            android:id="@+id/tvSignInHere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false"
            android:paddingVertical="4dp"
            android:text="@string/already_have_account_sign_in"
            android:textColor="@color/auth_heading"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Sign in" />
    </LinearLayout>
</LinearLayout>
