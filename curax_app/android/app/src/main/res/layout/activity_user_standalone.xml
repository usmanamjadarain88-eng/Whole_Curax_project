<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userStandaloneDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/userStandaloneMainColumn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_admin_dashboard_surface">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_toolbar_gradient">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/userStandaloneToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:title="Curax"
                    app:titleTextColor="@android:color/white" />
            </com.google.android.material.appbar.AppBarLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/userStandaloneTabStripCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:id="@+id/userStandaloneTabNavInner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_standalone_tab_nav_container"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/userStandaloneTabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:minHeight="48dp"
                        app:tabGravity="fill"
                        app:tabIndicator="@drawable/tab_indicator_standalone"
                        app:tabIndicatorAnimationMode="elastic"
                        app:tabIndicatorColor="@color/standalone_tab_indicator"
                        app:tabIndicatorFullWidth="false"
                        app:tabIndicatorGravity="bottom"
                        app:tabIndicatorHeight="3dp"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="14dp"
                        app:tabPaddingStart="14dp"
                        app:tabRippleColor="@color/standalone_tab_ripple"
                        app:tabSelectedTextAppearance="@style/TextAppearance.Curax.Tab.Selected"
                        app:tabSelectedTextColor="@color/standalone_tab_text_selected"
                        app:tabTextAppearance="@style/TextAppearance.Curax.Tab"
                        app:tabTextColor="@color/standalone_tab_text_normal" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/userStandalonePagerCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:cardBackgroundColor="@color/summary_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/summary_stroke"
                app:strokeWidth="1dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/userStandalonePager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/user_home_fetching_plan"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingSyncSwipeCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/key_value_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="20dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserSidebarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/user_sidebar_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <!-- 82dp frame: 72dp circle centered so the + badge sits on the rim without clipping; photo stays inside the circle. -->
                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:clipChildren="false">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserSidebarProfile"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="@string/user_sidebar_profile_image_cd"
                        android:elevation="0dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:outlineProvider="background"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_placeholder"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Curax.AvatarCircle"
                        app:strokeColor="@color/summary_stroke"
                        app:strokeWidth="1dp" />

                    <ImageButton
                        android:id="@+id/btnUserSidebarProfileAdd"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_profile_add_fab"
                        android:contentDescription="@string/user_sidebar_profile_change_cd"
                        android:elevation="0dp"
                        android:outlineProvider="background"
                        android:padding="4dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_input_add"
                        android:stateListAnimator="@null"
                        app:tint="@color/connect_button_bg" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvUserSidebarFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUserSidebarStatusPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/summary_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/summary_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <LinearLayout
                            android:id="@+id/sidebarSectionAdmin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/user_sidebar_admin_title"
                                    android:textAllCaps="true"
                                    android:textColor="@color/button_primary_bg"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.08"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvChevronAdmin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▼"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvUserSidebarAdminStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvUserSidebarAdminDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_sidebar_detail"
                                android:lineSpacingExtra="3dp"
                                android:padding="12dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/summary_stroke" />

                        <LinearLayout
                            android:id="@+id/sidebarSectionHealth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/user_sidebar_health_title"
                                    android:textAllCaps="true"
                                    android:textColor="@color/button_primary_bg"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.08"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvChevronHealth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▼"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvUserSidebarHealthStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvUserSidebarHealthDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_sidebar_detail"
                                android:lineSpacingExtra="3dp"
                                android:padding="12dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/summary_stroke" />

                        <LinearLayout
                            android:id="@+id/sidebarSectionAlerts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/user_sidebar_alerts_title"
                                    android:textAllCaps="true"
                                    android:textColor="@color/button_primary_bg"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.08"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvChevronAlerts"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▼"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvUserSidebarAlertsStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvUserSidebarAlertsDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_sidebar_detail"
                                android:lineSpacingExtra="3dp"
                                android:padding="12dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/summary_stroke" />

                        <LinearLayout
                            android:id="@+id/sidebarSectionRealtime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/user_sidebar_realtime_title"
                                    android:textAllCaps="true"
                                    android:textColor="@color/button_primary_bg"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.08"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvChevronRealtime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▼"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvUserSidebarRealtimeStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvUserSidebarRealtimeDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_sidebar_detail"
                                android:lineSpacingExtra="3dp"
                                android:padding="12dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUserSidebarConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStandaloneConnect"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/user_sidebar_connect_for_alerts"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="18dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
