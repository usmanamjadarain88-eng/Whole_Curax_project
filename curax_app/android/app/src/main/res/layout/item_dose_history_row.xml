<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed width + fixed height per cell (same as inventory table grid). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dose_history_table_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvDoseHistTs"
        android:layout_width="152dp"
        android:layout_height="@dimen/dose_history_table_row_height"
        android:background="@drawable/bg_table_cell"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="0dp"
        android:paddingEnd="8dp"
        android:paddingBottom="0dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="2026-04-15 09:00:00" />

    <TextView
        android:id="@+id/tvDoseHistBox"
        android:layout_width="44dp"
        android:layout_height="@dimen/dose_history_table_row_height"
        android:background="@drawable/bg_table_cell"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="B1" />

    <TextView
        android:id="@+id/tvDoseHistMed"
        android:layout_width="140dp"
        android:layout_height="@dimen/dose_history_table_row_height"
        android:background="@drawable/bg_table_cell"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Panadol" />

    <TextView
        android:id="@+id/tvDoseHistDose"
        android:layout_width="52dp"
        android:layout_height="@dimen/dose_history_table_row_height"
        android:background="@drawable/bg_table_cell"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="2" />

    <TextView
        android:id="@+id/tvDoseHistRem"
        android:layout_width="56dp"
        android:layout_height="@dimen/dose_history_table_row_height"
        android:background="@drawable/bg_table_cell"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="54" />
</LinearLayout>
