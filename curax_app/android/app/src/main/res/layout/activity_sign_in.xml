<?xml version="1.0" encoding="utf-8"?>
<!-- Form scrolls; "Not a member / Sign up" is pinned to the physical bottom (outside scroll). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_onboarding_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSignIn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="0dp"
        android:paddingBottom="2dp"
        android:scrollbars="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvTitleLine1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_screen_title_margin_top"
                android:includeFontPadding="false"
                android:letterSpacing="-0.031"
                android:text="@string/sign_in_heading_line1"
                android:textColor="@color/auth_heading"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="What’s your email" />

            <TextView
                android:id="@+id/tvTitleLine2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.031"
                android:text="@string/sign_in_heading_line2"
                android:textColor="@color/auth_heading"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitleLine1"
                tools:text="address?" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:lineSpacingMultiplier="1.12"
                android:text="@string/sign_in_subtitle_long"
                android:textColor="@color/auth_subtitle"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitleLine2"
                tools:text="Enter your email to get started and manage your medication schedule." />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="300dp" />

            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:labelFor="@id/etEmail"
                android:letterSpacing="-0.08"
                android:text="@string/auth_label_email_address"
                android:textColor="@color/auth_heading"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/glEmailLabel"
                tools:text="Email address" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:minHeight="44dp"
                app:boxBackgroundColor="@android:color/white"
                app:boxBackgroundMode="outline"
                app:boxCollapsedPaddingTop="0dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/auth_outline_muted"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:cursorColor="@color/auth_field_text"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelEmail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:gravity="center_vertical"
                    android:hint="@string/placeholder_email"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="15dp"
                    android:textColor="@color/auth_field_text"
                    android:textColorHighlight="@color/sign_in_text_highlight"
                    android:textColorHint="@color/auth_hint_email_muted"
                    android:textCursorDrawable="@drawable/auth_text_cursor"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:labelFor="@id/etPassword"
                android:letterSpacing="-0.08"
                android:text="@string/label_password_field"
                android:textColor="@color/auth_heading"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilEmail"
                tools:text="Password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                android:minHeight="44dp"
                app:boxBackgroundColor="@android:color/white"
                app:boxBackgroundMode="outline"
                app:boxCollapsedPaddingTop="0dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/auth_outline_muted"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:cursorColor="@color/auth_field_text"
                app:endIconContentDescription="@string/cd_show_password"
                app:endIconDrawable="@drawable/ic_auth_password_hidden"
                app:endIconMode="custom"
                app:endIconTint="@color/auth_password_toggle_tint"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelPassword">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:autofillHints="password"
                    android:gravity="center_vertical"
                    android:hint="@string/sign_in_password_hint_dots"
                    android:importantForAutofill="yes"
                    android:includeFontPadding="false"
                    android:inputType="textPassword"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="1"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="14dp"
                    android:scrollbars="none"
                    android:textColor="@color/auth_field_text"
                    android:textColorHighlight="@color/sign_in_text_highlight"
                    android:textColorHint="@color/auth_hint_password_muted"
                    android:textCursorDrawable="@drawable/auth_text_cursor"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/rowPrivacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilPassword">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/sign_in_privacy_line"
                    android:importantForAccessibility="yes"
                    android:src="@drawable/ic_auth_lock_privacy" />

                <TextView
                    android:id="@+id/tvPrivacyLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/sign_in_privacy_line"
                    android:textColor="@color/auth_promo_muted"
                    android:textSize="8sp"
                    tools:text="We’ll never share your email with anyone" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignIn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_login_cta"
                android:enabled="false"
                android:gravity="center"
                android:letterSpacing="0"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:text="@string/sign_in_button"
                android:textAllCaps="false"
                android:textColor="@color/auth_login_label"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowPrivacy" />

            <LinearLayout
                android:id="@+id/rowForgotPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnSignIn">

                <TextView
                    android:id="@+id/tvForgottenPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.08"
                    android:text="@string/sign_in_forgotten_password"
                    android:textColor="@color/auth_promo_muted"
                    android:textSize="12sp"
                    tools:text="Forgotten your password?" />

                <TextView
                    android:id="@+id/tvResetPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:includeFontPadding="false"
                    android:text="@string/sign_in_reset_password"
                    android:textColor="@color/auth_reset_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Reset password" />
            </LinearLayout>

            <!-- Fills remaining scroll height so there is no long empty drag below Forgot (fillViewport). -->
            <Space
                android:id="@+id/spacerBelowForgot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowForgotPassword" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/blockNotMember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvSignUpPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/sign_up_prompt_not_member"
            android:textColor="@color/auth_promo_muted"
            android:textSize="14sp"
            android:textStyle="normal"
            tools:text="Not a member?" />

        <TextView
            android:id="@+id/tvSignUpHere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false"
            android:paddingVertical="4dp"
            android:text="@string/sign_up_prompt_sign_up"
            android:textColor="@color/auth_heading"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Sign up" />
    </LinearLayout>
</LinearLayout>
