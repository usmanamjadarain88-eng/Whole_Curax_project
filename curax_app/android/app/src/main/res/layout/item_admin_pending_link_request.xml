<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/summary_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/summary_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPendingConnectMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.12"
            android:text="@string/admin_connection_request_message"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPendingRequestName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/connection_panel_title"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Sam Preview" />

        <LinearLayout
            android:id="@+id/rowPendingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPendingAccept"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/admin_users_accept"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/connect_button_bg"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_pending_accept_tick"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPendingDecline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_users_decline"
                android:textAllCaps="false"
                android:textColor="@color/delete_button"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_pending_reject_cross"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/delete_button"
                app:strokeColor="@color/delete_button" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
