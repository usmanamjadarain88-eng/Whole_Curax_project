<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_standalone_tab_canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.12"
            android:text="Medicine, stock, expiry, missed doses &amp; Health Hub — then email alerts."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:background="@color/summary_stroke" />

        <!-- App / version -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/toolbar_end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="App"
                        android:textColor="@color/connection_panel_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_standalone_settings_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alerts & schedules: single shell, flat inner cards -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/toolbar_end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Alerts &amp; schedules"
                        android:textColor="@color/connection_panel_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tune reminders below, then save."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Medicine time -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/key_value_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/summary_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Medicine time"
                            android:textColor="@color/connection_panel_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_medicine_30_before"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="true"
                            android:text="30 min before"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_medicine_15_before"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="15 min before"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_medicine_exact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Exact time"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Snooze duration (minutes)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_medicine_snooze"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="5"
                            android:inputType="number"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Expiry -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/key_value_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/summary_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Medicine expiry"
                            android:textColor="@color/connection_panel_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_expiry_30"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="true"
                            android:text="30 days before"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_expiry_15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="15 days before"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_expiry_7"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="7 days before"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_expiry_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1 day before"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stock -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/key_value_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/summary_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stock"
                            android:textColor="@color/connection_panel_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_stock_enabled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="true"
                            android:text="Enable stock alerts"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Low stock threshold"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_stock_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="5"
                            android:inputType="number"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_stock_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alert when empty"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_stock_critical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Critical alert when low"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Missed dose -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/key_value_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/summary_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Missed dose"
                            android:textColor="@color/connection_panel_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_missed_5_min"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="true"
                            android:text="After 5 min: reminder"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_missed_15_urgent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After 15 min: urgent alert"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_missed_30_family"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After 30 min: notify family"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_missed_1hr_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After 1 hour: log as missed"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Family / Admin email"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_missed_family_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="admin@example.com"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Health Hub plans -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/key_value_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/summary_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Health Hub plans"
                            android:textColor="@color/connection_panel_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Each planned item needs a time on the plan."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_plan_30_before"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="true"
                            android:text="30 min before"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_plan_15_before"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="15 min before"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_plan_exact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Exact time"
                            android:textColor="@color/text_primary"
                            app:buttonTint="@color/checkbox_tint"
                            android:checked="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Email alerts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/summary_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/toolbar_end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/system_gmail_section_title"
                        android:textColor="@color/connection_panel_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/system_gmail_curax_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_gmail_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/system_gmail_alerts_switch"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:thumbTint="@color/checkbox_tint"
                    app:trackTint="@color/summary_stroke" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Curax.TextInputLayout.OutlinedStandalone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/system_gmail_recipient_hint"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:hintEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_gmail_recipients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_system_settings"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/standalone_save_all_system_settings"
            app:backgroundTint="@color/button_primary_bg"
            app:cornerRadius="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />
    </LinearLayout>
</ScrollView>
