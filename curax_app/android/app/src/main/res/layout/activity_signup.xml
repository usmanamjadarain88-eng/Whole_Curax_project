<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_onboarding_bg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSignUp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="8dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="48dp">

                <TextView
                    android:id="@+id/tvTitleLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="52dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.031"
                    android:text="@string/sign_up_screen_title"
                    android:textColor="@color/auth_heading"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Create your" />

                <TextView
                    android:id="@+id/tvTitleLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.031"
                    android:text="@string/sign_up_heading_line2"
                    android:textColor="@color/auth_heading"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="account"
                    tools:visibility="gone" />

                <TextView
                    android:id="@+id/tvAuthSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:lineSpacingMultiplier="1.12"
                    android:text="@string/sign_up_subtitle_long"
                    android:textColor="@color/auth_subtitle"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <!-- Step 1: email + password -->
                    <LinearLayout
                        android:id="@+id/groupSignUpStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/labelEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginTop="24dp"
                            android:includeFontPadding="false"
                            android:labelFor="@id/etEmail"
                            android:letterSpacing="-0.08"
                            android:text="@string/auth_label_email_address"
                            android:textColor="@color/auth_heading"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:clipChildren="false"
                            android:clipToOutline="false"
                            android:clipToPadding="false"
                            android:minHeight="@dimen/auth_outlined_edit_min_height"
                            app:boxBackgroundColor="@android:color/white"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/auth_outline_stroke"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:cursorColor="@color/auth_field_text"
                            app:hintAnimationEnabled="false"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="emailAddress"
                                android:gravity="center_vertical"
                                android:hint="@string/placeholder_email"
                                android:importantForAutofill="yes"
                                android:includeFontPadding="true"
                                android:inputType="textEmailAddress"
                                android:minHeight="@dimen/auth_outlined_edit_min_height"
                                android:paddingStart="12dp"
                                android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                                android:paddingEnd="12dp"
                                android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                                android:textColor="@color/auth_field_text"
                                android:textColorHint="@color/auth_subtitle"
                                android:textCursorDrawable="@drawable/auth_text_cursor"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/labelPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginTop="20dp"
                            android:includeFontPadding="false"
                            android:labelFor="@id/etPassword"
                            android:letterSpacing="-0.08"
                            android:text="@string/label_password_field"
                            android:textColor="@color/auth_heading"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPasswordStep1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:clipChildren="false"
                            android:clipToOutline="false"
                            android:clipToPadding="false"
                            android:minHeight="@dimen/auth_outlined_edit_min_height"
                            app:boxBackgroundColor="@android:color/white"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/auth_outline_stroke"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:cursorColor="@color/auth_field_text"
                            app:endIconContentDescription="@string/cd_show_password"
                            app:endIconDrawable="@drawable/ic_auth_password_hidden"
                            app:endIconMode="custom"
                            app:endIconTint="@color/auth_password_toggle_tint"
                            app:hintAnimationEnabled="false"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/auth_outlined_edit_min_height"
                                android:autofillHints="newPassword"
                                android:gravity="center_vertical"
                                android:hint="@string/sign_in_password_hint_dots"
                                android:importantForAutofill="yes"
                                android:includeFontPadding="true"
                                android:inputType="textPassword"
                                android:lineSpacingExtra="0dp"
                                android:maxLines="1"
                                android:overScrollMode="never"
                                android:paddingStart="12dp"
                                android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                                android:paddingEnd="44dp"
                                android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                                android:scrollbars="none"
                                android:textColor="@color/auth_field_text"
                                android:textColorHint="@color/auth_password_hint"
                                android:textCursorDrawable="@drawable/auth_text_cursor"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSignUp"
                            android:layout_width="match_parent"
                            android:layout_height="47dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_auth_login_cta"
                            android:enabled="false"
                            android:letterSpacing="0"
                            android:paddingStart="10dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="14dp"
                            android:stateListAnimator="@null"
                            android:text="@string/sign_up_button"
                            android:textAllCaps="false"
                            android:textColor="@color/auth_login_label"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Step 2: email OTP (panel typography matches Sign in screen) -->
                    <LinearLayout
                        android:id="@+id/groupSignUpStep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/verify_pin_panel_intro"
                            android:textColor="@color/auth_subtitle"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVerifySubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="start"
                            android:textColor="@color/auth_subtitle"
                            android:textSize="14sp"
                            tools:text="We sent a 6-digit code to you@x.com" />

                        <TextView
                            android:id="@+id/tvEmailVerifiedBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="start"
                            android:text="@string/signup_email_verified_continue"
                            android:textColor="@color/auth_heading"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/otpInputBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Digits above a full-width rule split into 6 segments; etOtp overlay for tap + keyboard -->
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:minHeight="92dp">

                                <!-- One full-width rule split into 6 equal segments; tiny gaps = "cuts". -->
                                <LinearLayout
                                    android:id="@+id/otpSlotsContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:baselineAligned="false"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:gravity="center_vertical"
                                    android:minHeight="92dp"
                                    android:orientation="horizontal">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="@dimen/verify_otp_segment_gap"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvOtpDigit0"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:fontFamily="monospace"
                                            android:gravity="center"
                                            android:includeFontPadding="false"
                                            android:minHeight="40dp"
                                            android:textColor="@color/auth_heading"
                                            android:textSize="28sp"
                                            android:textStyle="bold" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/verify_otp_rule_thickness"
                                            android:background="@color/auth_field_border" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="@dimen/verify_otp_segment_gap"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvOtpDigit1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:fontFamily="monospace"
                                            android:gravity="center"
                                            android:includeFontPadding="false"
                                            android:minHeight="40dp"
                                            android:textColor="@color/auth_heading"
                                            android:textSize="28sp"
                                            android:textStyle="bold" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/verify_otp_rule_thickness"
                                            android:background="@color/auth_field_border" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="@dimen/verify_otp_segment_gap"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvOtpDigit2"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:fontFamily="monospace"
                                            android:gravity="center"
                                            android:includeFontPadding="false"
                                            android:minHeight="40dp"
                                            android:textColor="@color/auth_heading"
                                            android:textSize="28sp"
                                            android:textStyle="bold" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/verify_otp_rule_thickness"
                                            android:background="@color/auth_field_border" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="@dimen/verify_otp_segment_gap"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvOtpDigit3"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:fontFamily="monospace"
                                            android:gravity="center"
                                            android:includeFontPadding="false"
                                            android:minHeight="40dp"
                                            android:textColor="@color/auth_heading"
                                            android:textSize="28sp"
                                            android:textStyle="bold" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/verify_otp_rule_thickness"
                                            android:background="@color/auth_field_border" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="@dimen/verify_otp_segment_gap"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvOtpDigit4"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:fontFamily="monospace"
                                            android:gravity="center"
                                            android:includeFontPadding="false"
                                            android:minHeight="40dp"
                                            android:textColor="@color/auth_heading"
                                            android:textSize="28sp"
                                            android:textStyle="bold" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/verify_otp_rule_thickness"
                                            android:background="@color/auth_field_border" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvOtpDigit5"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:fontFamily="monospace"
                                            android:gravity="center"
                                            android:includeFontPadding="false"
                                            android:minHeight="40dp"
                                            android:textColor="@color/auth_heading"
                                            android:textSize="28sp"
                                            android:textStyle="bold" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/verify_otp_rule_thickness"
                                            android:background="@color/auth_field_border" />
                                    </LinearLayout>
                                </LinearLayout>


                                <EditText
                                    android:id="@+id/etOtp"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@android:color/transparent"
                                    android:cursorVisible="false"
                                    android:digits="0123456789"
                                    android:gravity="center"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="6"
                                    android:textColor="@android:color/transparent"
                                    android:textColorHint="@android:color/transparent"
                                    android:textSize="22sp" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvResendCountdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/inter"
                                android:gravity="center"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="Resend code in 15 s" />

                            <TextView
                                android:id="@+id/tvResend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:enabled="false"
                                android:fontFamily="@font/inter"
                                android:paddingVertical="8dp"
                                android:text="@string/resend_code"
                                android:textColor="@color/auth_heading"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:alpha="0.45" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnVerifyOtp"
                            android:layout_width="match_parent"
                            android:layout_height="47dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="22dp"
                            android:background="@drawable/bg_auth_login_cta"
                            android:enabled="false"
                            android:letterSpacing="0"
                            android:paddingStart="10dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="14dp"
                            android:stateListAnimator="@null"
                            android:text="@string/verify"
                            android:textAllCaps="false"
                            android:textColor="@color/auth_login_label"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSignUpAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/sign_up_as_admin"
                    android:textColor="@color/auth_promo_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <WebView
                    android:id="@+id/authBottomSvg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_bottom_decoration_height"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:importantForAccessibility="no"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
