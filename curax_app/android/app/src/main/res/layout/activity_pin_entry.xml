<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_onboarding_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvPinRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/auth_subtitle"
                android:textSize="13sp"
                tools:text="Secure Access" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.031"
                android:text="Enter PIN"
                android:textColor="@color/auth_heading"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.12"
                android:text="Unlock your dashboard with your 4-digit PIN or biometrics."
                android:textColor="@color/auth_subtitle"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false"
                android:minHeight="@dimen/auth_outlined_edit_min_height"
                app:boxBackgroundColor="@android:color/white"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/auth_outline_muted"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconMode="password_toggle"
                app:hintAnimationEnabled="false"
                app:hintEnabled="true"
                app:hintTextColor="@color/auth_subtitle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPinEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="true"
                    android:hint="4-digit PIN"
                    android:inputType="numberPassword"
                    android:letterSpacing="0.12"
                    android:maxLength="8"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    android:paddingStart="12dp"
                    android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                    android:paddingEnd="12dp"
                    android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                    android:textColor="@color/auth_field_text"
                    android:textColorHint="@color/auth_subtitle"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUnlockWithPin"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_login_cta"
                    android:letterSpacing="0"
                    android:stateListAnimator="@null"
                    android:text="Unlock"
                    android:textAllCaps="false"
                    android:textColor="@color/auth_login_label"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFingerprint"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:contentDescription="Use fingerprint"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text=""
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_fingerprint"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/auth_field_text"
                    app:strokeColor="@color/auth_field_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPinHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Use fingerprint if available on this device"
                android:textColor="@color/auth_subtitle"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
