<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_onboarding_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:minHeight="?attr/actionBarSize"
        android:paddingStart="2dp"
        android:paddingEnd="8dp"
        app:navigationContentDescription="@string/forgot_password_nav_back_cd"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/auth_heading"
        app:title="@string/forgot_password_title"
        app:titleTextColor="@color/auth_heading" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvForgotHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="@string/forgot_password_step_email_title"
                android:textColor="@color/auth_heading"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvForgotSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.12"
                android:text="@string/forgot_password_step_email_body"
                android:textColor="@color/auth_subtitle"
                android:textSize="14sp" />

            <!-- Step 1: email -->
            <LinearLayout
                android:id="@+id/groupForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilForgotEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    app:boxBackgroundColor="@android:color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/auth_outline_muted"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:cursorColor="@color/auth_field_text"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:gravity="center_vertical"
                        android:hint="@string/placeholder_email"
                        android:importantForAutofill="yes"
                        android:includeFontPadding="true"
                        android:inputType="textEmailAddress"
                        android:minHeight="@dimen/auth_outlined_edit_min_height"
                        android:paddingStart="12dp"
                        android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                        android:paddingEnd="12dp"
                        android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                        android:textColor="@color/auth_field_text"
                        android:textColorHint="@color/auth_hint_email_muted"
                        android:textCursorDrawable="@drawable/auth_text_cursor"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnForgotSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_auth_login_cta"
                    android:letterSpacing="0"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:text="@string/forgot_password_send_code"
                    android:textAllCaps="false"
                    android:textColor="@color/auth_login_label"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Step 2: OTP -->
            <LinearLayout
                android:id="@+id/groupForgotOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilForgotOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    app:boxBackgroundColor="@android:color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/auth_outline_muted"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:cursorColor="@color/auth_field_text"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:hint="@string/forgot_password_otp_hint"
                        android:importantForAutofill="no"
                        android:includeFontPadding="true"
                        android:inputType="number"
                        android:maxLength="6"
                        android:minHeight="@dimen/auth_outlined_edit_min_height"
                        android:paddingStart="12dp"
                        android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                        android:paddingEnd="12dp"
                        android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                        android:textColor="@color/auth_field_text"
                        android:textColorHint="@color/auth_subtitle"
                        android:textCursorDrawable="@drawable/auth_text_cursor"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvForgotResend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/resend_code"
                    android:textColor="@color/auth_heading"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnForgotOtpNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_auth_login_cta"
                    android:enabled="false"
                    android:letterSpacing="0"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:text="@string/forgot_password_continue"
                    android:textAllCaps="false"
                    android:textColor="@color/auth_login_label"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Step 3: new password -->
            <LinearLayout
                android:id="@+id/groupForgotNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilForgotNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    app:boxBackgroundColor="@android:color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/auth_outline_muted"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:cursorColor="@color/auth_field_text"
                    app:endIconContentDescription="@string/cd_show_password"
                    app:endIconDrawable="@drawable/ic_auth_password_hidden"
                    app:endIconMode="custom"
                    app:endIconTint="@color/auth_password_toggle_tint"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:gravity="center_vertical"
                        android:hint="@string/forgot_password_new_hint"
                        android:importantForAutofill="yes"
                        android:includeFontPadding="true"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:minHeight="@dimen/auth_outlined_edit_min_height"
                        android:paddingStart="12dp"
                        android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                        android:paddingEnd="44dp"
                        android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                        android:textColor="@color/auth_field_text"
                        android:textColorHint="@color/auth_hint_password_muted"
                        android:textCursorDrawable="@drawable/auth_text_cursor"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilForgotConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:minHeight="@dimen/auth_outlined_edit_min_height"
                    app:boxBackgroundColor="@android:color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/auth_outline_muted"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:cursorColor="@color/auth_field_text"
                    app:endIconContentDescription="@string/cd_show_password"
                    app:endIconDrawable="@drawable/ic_auth_password_hidden"
                    app:endIconMode="custom"
                    app:endIconTint="@color/auth_password_toggle_tint"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:gravity="center_vertical"
                        android:hint="@string/forgot_password_confirm_hint"
                        android:importantForAutofill="yes"
                        android:includeFontPadding="true"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:minHeight="@dimen/auth_outlined_edit_min_height"
                        android:paddingStart="12dp"
                        android:paddingTop="@dimen/auth_outlined_edit_padding_top"
                        android:paddingEnd="44dp"
                        android:paddingBottom="@dimen/auth_outlined_edit_padding_bottom"
                        android:textColor="@color/auth_field_text"
                        android:textColorHint="@color/auth_hint_password_muted"
                        android:textCursorDrawable="@drawable/auth_text_cursor"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnForgotSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_auth_login_cta"
                    android:enabled="false"
                    android:letterSpacing="0"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:text="@string/forgot_password_save"
                    android:textAllCaps="false"
                    android:textColor="@color/auth_login_label"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
