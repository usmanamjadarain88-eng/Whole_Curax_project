<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#1F5C48"
                android:endColor="#0A1814"
                android:startColor="#163D30"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#3D6B5C" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
