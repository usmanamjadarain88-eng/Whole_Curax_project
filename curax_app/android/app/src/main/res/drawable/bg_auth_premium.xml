<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#EAF8F0"
                android:centerColor="#E0F4E8"
                android:endColor="#D4EDDF" />
        </shape>
    </item>

    <item android:gravity="top|end" android:right="-40dp" android:top="-50dp">
        <shape android:shape="oval">
            <size android:width="210dp" android:height="210dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerColor="#66B7E3C7"
                android:endColor="#00B7E3C7" />
        </shape>
    </item>

    <item android:gravity="bottom|start" android:left="-60dp" android:bottom="-70dp">
        <shape android:shape="oval">
            <size android:width="250dp" android:height="250dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerColor="#66A0D9BD"
                android:endColor="#00A0D9BD" />
        </shape>
    </item>
</layer-list>
