<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Curax" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/toolbar_start</item>
        <item name="android:navigationBarColor">@color/toolbar_start</item>
        <item name="colorPrimary">@color/toolbar_start</item>
        <item name="colorPrimaryVariant">@color/toolbar_end</item>
        <item name="colorSecondary">@color/badge_end</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- User standalone toolbar: theme, mode, overflow — same slot size, one row -->
    <style name="Theme.Curax.UserToolbar" parent="Theme.Curax">
        <item name="actionButtonStyle">@style/Curax.Widget.ToolbarActionButton</item>
        <item name="android:actionButtonStyle">@style/Curax.Widget.ToolbarActionButton</item>
        <item name="actionOverflowButtonStyle">@style/Curax.Widget.ToolbarOverflowButton</item>
    </style>

    <style name="Curax.Widget.ToolbarActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="Curax.Widget.ToolbarOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
</resources>
