# Central API base URL (GET /admin/data). No trailing slash.
CENTRAL_API_URL=https://your-central-api.example.com

# Ably root API key (needs publish). Used only on Vercel for POST /notify_admin → fan-out.
# Create at https://ably.com — apps need a separate subscribe-capable key (see deploy notes).
ABLY_API_KEY=

# Local aiohttp relay only (python server.py / Docker). Vercel sets PORT automatically.
PORT=5052
